sequenceDiagram
    participant Env as Environment
    participant S as server.py
    participant Man as manifest.py
    participant Reg as registry.py
    participant Cred as credentials.py
    participant Mod as ToolModule
    participant FM as FastMCP

    rect rgb(15, 52, 96)
        Note over Env,FM: Startup
        Env->>S: AGENT_ID, AGENT_TYPE
        S->>Man: load(manifest_path)
        Man-->>S: modules[], credentials config
        S->>Reg: discover + filter modules
        Reg->>Cred: resolve credentials for each module
        Cred-->>Reg: injected contexts
        Reg->>Mod: instantiate with context + scope
        Reg->>FM: register tools (filtered by mode)
        FM-->>S: server ready
    end

    rect rgb(26, 26, 46)
        Note over Env,FM: Runtime (ToolModule call)
        FM->>Mod: tool_call(args)
        activate Mod
        Note right of Mod: @audited wrapper logs the call
        Mod->>Mod: scope.enforce(args)
        alt scope violation
            Mod-->>FM: ScopeError (blocked + logged)
        else within scope
            Mod->>Mod: execute tool logic
            Mod-->>FM: result (logged)
        end
        deactivate Mod
    end

    rect rgb(26, 46, 26)
        Note over Env,FM: Runtime (mcp_proxy forwarded call)
        FM->>Mod: proxy_call(tool, args)
        activate Mod
        Note right of Mod: pre-call hook registry fires (e.g. signing hook)
        Mod->>Mod: run_before_hooks(tool, kwargs)
        Mod->>Mod: validate inputSchema
        Mod->>Mod: run middleware (rate_limits, arg_filters, hitl)
        alt blocked or rejected
            Mod-->>FM: RateLimitError / HitlRejectedError (logged)
        else approved
            Mod->>Mod: forward to upstream MCP server
            Mod-->>FM: result (logged)
        end
        deactivate Mod
    end
